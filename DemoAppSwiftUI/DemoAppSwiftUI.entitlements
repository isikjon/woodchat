<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Пуш-уведомления. development — для сборок из Xcode (APNs sandbox).
		Перед выкладкой в TestFlight/App Store поменять на production
		и переключить APNS_ENVIRONMENT=production в .env шлюза.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
